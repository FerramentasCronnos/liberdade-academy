# =============================================================================
# API Liberdade Academy — uso local (fora do Docker) OU referência das envs
# No Portainer, estas vars vêm do compose / infra/.env
# =============================================================================

# --- Obrigatório: Postgres (auth, comunidade, ranking, catálogo, vendas) ---
DATABASE_URL=postgresql://liberdade:liberdade@localhost:5432/liberdade_academy?schema=public

# --- Recomendado: Redis (cache) ---
REDIS_URL=redis://localhost:6379

# --- Obrigatório: sessão JWT ---
JWT_SECRET=troque-esta-chave-em-producao

PORT=3000
HOST=0.0.0.0

# --- Opcional: catálogo TikTok Shop (ver docs/INTEGRATIONS.md) ---
# Providers com adapter: seed | apify | kalodata
CATALOG_PROVIDER=seed
CATALOG_REGIONS=BR
CATALOG_SYNC_LIMIT=100

APIFY_TOKEN=
# Testado: unseenuser/TikTok-Shop-Scraper (BR + US, ~US$ 4,50/mil produtos)
APIFY_ACTOR_ID=unseenuser/TikTok-Shop-Scraper
APIFY_ACTOR_ID_BR=
APIFY_ACTOR_ID_US=
APIFY_PRICE_DIVISOR=100
APIFY_SEARCH_TERMS=
APIFY_INPUT_JSON=

CALODATA_API_KEY=
CALODATA_BASE_URL=https://api.kalodata.com/v1
