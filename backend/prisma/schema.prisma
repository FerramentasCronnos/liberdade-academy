generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(cuid())
  name                 String
  email                String            @unique
  passwordHash         String
  avatar               String?
  bio                  String?
  instagram            String?
  tiktok               String?
  points               Int               @default(0)
  level                Int               @default(1)
  xp                   Int               @default(0)
  rank                 Int               @default(999)
  joinedAt             DateTime          @default(now())
  onboardingCompleted  Boolean           @default(false)
  niche                String?
  alreadySelling       Boolean?
  revenueRange         String?
  goal                 String?
  onboardingAt         DateTime?
  productsViewed       Int               @default(0)
  salesMade            Int               @default(0)
  communityPosts       Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  isAdmin              Boolean           @default(false)
  posts                Post[]
  likes                PostLike[]
  comments             Comment[]
  selling              SellingProduct[]
  notifications        Notification[]
  notificationReads    NotificationRead[]
  missionCompletions   MissionCompletion[]
  redemptions          Redemption[]
  pointsEntries        PointsEntry[]
  affiliateAccounts    AffiliateAccount[]
  offerTemplates       OfferTemplate[]
  affiliateLinks       AffiliateLink[]
  landingPages         LandingPage[]
  adCreatives          AdCreative[]
}

/// Anúncio do Baú: criativo em imagem que a administração sobe e os membros
/// baixam para usar nas próprias campanhas.
model AdCreative {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("geral")
  image       String
  notes       String?
  active      Boolean  @default(true)
  downloads   Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([category, active])
}

/// Página pública do membro (presell ou link na bio).
/// `config` guarda cores, textos, contador, escassez e pixel — o formato varia
/// por template e mudaria a cada ajuste de layout, então não vira coluna.
model LandingPage {
  id                String      @id @default(cuid())
  userId            String
  kind              String      @default("presell")
  slug              String      @unique
  template          String      @default("minimalista")
  title             String
  subtitle          String?
  avatar            String?
  config            Json?
  /// Manda todos os cliques para um grupo até o limite, depois vai pro próximo.
  rotationAuto      Boolean     @default(true)
  defaultClickLimit Int?
  published         Boolean     @default(false)
  views             Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups            PageGroup[]
  clicks            PageClick[]

  @@index([userId, kind])
}

/// Grupo de WhatsApp para onde o botão da página envia.
model PageGroup {
  id         String      @id @default(cuid())
  pageId     String
  name       String
  inviteUrl  String
  clickLimit Int?
  clicks     Int         @default(0)
  active     Boolean     @default(true)
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  page       LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageClicks PageClick[]

  @@index([pageId, order])
}

/// Um clique no botão. Guarda origem para as estatísticas.
model PageClick {
  id          String      @id @default(cuid())
  pageId      String
  groupId     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  referrer    String?
  device      String?
  country     String?
  createdAt   DateTime    @default(now())
  page        LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  group       PageGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
}


/// Conta de afiliado do membro em cada marketplace.
/// `secret` guarda credenciais cifradas (AES-256-GCM); `publicId` é a tag ou
/// id que aparece no próprio link e não precisa de sigilo.
model AffiliateAccount {
  id          String   @id @default(cuid())
  userId      String
  marketplace String
  publicId    String?
  secret      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplace])
}

/// Link gerado, guardado para histórico e para o membro reaproveitar.
model AffiliateLink {
  id          String   @id @default(cuid())
  userId      String
  marketplace String
  originalUrl String
  affiliateUrl String
  title       String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Template de mensagem para divulgação.
model OfferTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  marketplace String   @default("shopee")
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Missão da gamificação. "automatic" é creditada por evento no sistema;
/// "proof" exige print e passa por revisão.
model Mission {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String
  points      Int
  category    String              @default("outras")
  kind        String              @default("proof")
  repeatable  Boolean             @default(false)
  /// Janela mínima entre repetições, em horas (24 = uma vez por dia).
  cooldownHours Int?
  active      Boolean             @default(true)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  completions MissionCompletion[]
}

model MissionCompletion {
  id            String    @id @default(cuid())
  missionId     String
  userId        String
  /// pending | approved | rejected
  status        String    @default("pending")
  proofUrl      String?
  note          String?
  pointsAwarded Int       @default(0)
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?
  mission       Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, missionId])
  @@index([status])
}

model Reward {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  image       String?
  costPoints  Int
  /// null = estoque ilimitado
  stock       Int?
  active      Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  redemptions Redemption[]
}

model Redemption {
  id         String    @id @default(cuid())
  rewardId   String
  userId     String
  costPoints Int
  /// requested | approved | delivered | rejected
  status     String    @default("requested")
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reward     Reward    @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Extrato de pontos. O saldo em User.points é derivado daqui — toda alteração
/// grava uma linha, para o histórico bater com o saldo.
model PointsEntry {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Product {
  id            String           @id @default(cuid())
  externalId    String?
  provider      String           @default("seed")
  region        String           @default("BR")
  currency      String           @default("BRL")
  productUrl    String?
  name          String
  image         String
  price         Float
  category      String
  supplier      String
  rating        Float            @default(4.5)
  salesCount    Int              @default(0)
  tiktokViews   Int?
  isViral       Boolean          @default(false)
  commission    Int?
  description   String
  supplierShips Boolean          @default(true)
  active        Boolean          @default(true)
  syncedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  selling       SellingProduct[]

  @@unique([provider, region, externalId])
  @@index([region, category, active])
  @@index([region, isViral, salesCount])
}

model Post {
  id        String     @id @default(cuid())
  content   String
  category  String
  image     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  Comment[]
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model SellingProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Notification {
  id        String             @id @default(cuid())
  title     String
  body      String
  route     String?
  createdAt DateTime           @default(now())
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads     NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  notificationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
}
