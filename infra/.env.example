# =============================================================================
# Liberdade Academy — variáveis da STACK (Portainer / docker compose)
# Copie para infra/.env ou cole no Portainer > Stack > Environment variables
# Guia completo: docs/INTEGRATIONS.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1) OBRIGATÓRIO — banco + acesso (auth, comunidade, ranking, vendas)
#    Postgres e Redis sobem NO COMPOSE (zero SaaS extra).
# -----------------------------------------------------------------------------

# Senha do PostgreSQL (users, posts, products, ranking, notificações)
POSTGRES_PASSWORD=troque-esta-senha-forte

# Segredo JWT da API (login / sessão / controle de acesso)
JWT_SECRET=gere-uma-chave-longa-aleatoria-min-32-chars

# Porta pública da API (Caddy)
API_PORT=8080

# Adminer (UI do banco). Em produção: remova o serviço ou restrinja por VPN.
ADMINER_PORT=8088

# -----------------------------------------------------------------------------
# 2) OPCIONAL — catálogo TikTok Shop
#    Sem isso o app JÁ FUNCIONA com o seed do Postgres.
#    Confira o estado atual em: GET /catalog/status
# -----------------------------------------------------------------------------

# Providers COM adapter implementado: seed | apify | kalodata
#   seed     → não busca nada; catálogo = o que está no Postgres (padrão)
#   apify    → scrapers de TikTok Shop, pay-per-use (mais barato)
#   kalodata → cobre BR e US, mas a API exige plano Enterprise
#
# EchoTik e Scavio ainda NÃO têm adapter. As variáveis deles foram removidas
# daqui porque não faziam nada — ver docs/INTEGRATIONS.md antes de adicionar.
CATALOG_PROVIDER=seed

# Regiões que o sync percorre (BR, US ou "BR,US")
CATALOG_REGIONS=BR

# Máximo de produtos por região em cada sync
CATALOG_SYNC_LIMIT=100

# --- Apify (apify.com → Settings → API & Integrations → Personal API token) ---
APIFY_TOKEN=

# Actor de TikTok Shop. Aceita "usuario/actor" ou "usuario~actor".
#
# TESTADO E RECOMENDADO: unseenuser/TikTok-Shop-Scraper
#   - cobre BR e US (16 regiões)  - US$ 0,0045 por produto (~US$ 4,50/mil)
#   - busca por palavra-chave funciona no Brasil (validado com dados reais)
#
# Evite (verificado):
#   pro100chok/tiktok-shop-scraper → o campo region só aceita "us"
#   herus13/tiktok-shop-scraper    → busca por palavra só nos EUA; fora deles
#                                    exige URL de produto + proxy residencial
APIFY_ACTOR_ID=unseenuser/TikTok-Shop-Scraper
APIFY_ACTOR_ID_BR=
APIFY_ACTOR_ID_US=

# Divisor de preço. O unseenuser devolve valor em CENTAVOS (e o priceDisplay
# dele mostra errado), então use 100. Actors que devolvem em reais: deixe 1.
APIFY_PRICE_DIVISOR=100

# Termos de busca por categoria. O TikTok Shop não expõe "mais vendidos" numa
# URL estável, então a descoberta é por palavra-chave e o produto herda a
# categoria do termo. Deixe vazio pra usar os termos padrão (BR e US).
# Formato: {"BR":{"beleza":["kit skincare"],"tech":["fone bluetooth"]}}
APIFY_SEARCH_TERMS=

# Só pra actors com input diferente do recomendado — SUBSTITUI o payload
# inteiro. Placeholders: {{region}} {{limit}} {{keywords}} {{category}}
APIFY_INPUT_JSON=

# --- Kalodata Open API (somente com plano Enterprise + access key) ---
CALODATA_API_KEY=
CALODATA_BASE_URL=https://api.kalodata.com/v1

# -----------------------------------------------------------------------------
# 3) OPCIONAL — comissão por categoria (%)
#    O scraper de TikTok Shop BR NÃO devolve taxa de comissão: o endpoint de
#    detalhe do produto só funciona nos EUA. Sem esta config o app mostra
#    "comissão não informada" em vez de inventar número.
#    Pegue os percentuais reais no TikTok Shop Affiliate Center.
#    A chave "padrao" vale para categorias não listadas.
# -----------------------------------------------------------------------------
COMMISSION_RATES_BR={"beleza":18,"saude":15,"fitness":15,"moda":12,"casa":12,"tech":8,"digital":25,"fisico":10,"padrao":12}
COMMISSION_RATES_US=

# -----------------------------------------------------------------------------
# 4) OBRIGATÓRIO se for usar credenciais de afiliado
#    Cifra os segredos (App Secret etc.) no banco. Gere com:
#      node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#    Sem ela a API recusa gravar segredo, em vez de gravar em texto puro.
# -----------------------------------------------------------------------------
CREDENTIALS_KEY=
